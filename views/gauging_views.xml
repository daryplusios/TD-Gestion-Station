<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action : Ce que le système fait quand on clique sur le menu -->
    <record id="action_td_gauging" model="ir.actions.act_window">
        <field name="name">Gauging</field> # Titre de la fenêtre
        <field name="res_model">gauging.gauging</field> # Modèle à ouvrir
        <field name="view_mode">list,form</field> # Modes liste et formulaire
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première fiche de jaugeage !</p>
        </field>
    </record>

    <!-- MENU RACINE : APPARAÎT SUR LE DASHBOARD (CAR PAS DE PARENT) -->
    <menuitem id="menu_td_gauging_root" 
              name="TD Gauging" 
              web_icon="base,static/description/settings.png"
              sequence="1"/> # Ordre d'affichage sur le dashboard

    <!-- SOUS-MENU : DANS L'APPLICATION -->
    <menuitem id="menu_td_gauging_main" 
              name="Fiches Gauging" 
              parent="menu_td_gauging_root" 
              action="action_td_gauging" 
              sequence="10"/>

    <!-- Vue Liste (Odoo 18 : balise list) -->
    <record id="view_gauging_list" model="ir.ui.view">
        <field name="name">gauging.gauging.list</field>
        <field name="model">gauging.gauging</field>
        <field name="arch" type="xml">
            <list string="Gaugings"> # Standard Odoo 18
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="expected_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'validated'"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_gauging_form" model="ir.ui.view">
        <field name="name">gauging.gauging.form</field>
        <field name="model">gauging.gauging</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Valider" type="object" class="oe_highlight" invisible="state == 'validated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="date" readonly="state == 'validated'"/><field name="user_id"/></group></group>
                    <notebook>
                        <page string="Réservoirs">
                            <field name="tank_line_ids" readonly="state == 'validated'">
                                <list editable="bottom">
                                    <field name="tank_name"/><field name="start_inches"/><field name="end_inches"/><field name="start_gallons"/><field name="end_gallons"/><field name="variation_gallons" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ventes Pompes">
                            <field name="pump_line_ids" readonly="state == 'validated'">
                                <list editable="bottom">
                                    <field name="pump_id"/><field name="product_id"/><field name="employee_id"/><field name="start_counter"/><field name="end_counter"/><field name="unit_price"/><field name="amount_sold" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Décompte Financier">
                            <group><group string="Cash / Cartes"><field name="cash_HTG"/><field name="cash_USD"/><field name="card_HTG"/><field name="card_USD"/></group><group string="Coupons"><field name="coupon_1000_HTG"/><field name="coupon_500_HTG"/></group></group>
                            <label for="check_line_ids" string="Chèques"/><field name="check_line_ids"><list editable="bottom"><field name="amount" sum="Total"/></list></field>
                            <label for="credit_line_ids" string="Fiches de Crédit"/><field name="credit_line_ids"><list editable="bottom"><field name="amount" sum="Total"/></list></field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer"><field name="expected_amount"/><field name="counted_amount_total"/><field name="difference" class="oe_subtotal_footer_separator" decoration-danger="difference &lt; 0"/></group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>