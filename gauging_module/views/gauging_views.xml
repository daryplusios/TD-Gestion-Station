<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gauging_form" model="ir.ui.view">
        <field name="name">gauging.gauging.form</field>
        <field name="model">gauging.gauging</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Valider le Rapport" type="object" class="oe_highlight" invisible="state == 'validated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence du Rapport"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Configuration de la Rotation">
                            <field name="date" readonly="state == 'validated'"/>
                            <field name="shift" widget="radio" options="{'horizontal': true}" readonly="state == 'validated'"/>
                            <field name="supervisor_id" readonly="1"/>
                            <field name="currency_rate" string="Taux de Change USD en Gourdes" readonly="state == 'validated'"/>
                        </group>
                        <group string="Résumé Financier Global" class="oe_subtotal_footer">
                            <field name="total_sales_expected" widget="monetary" string="Ventes Théoriques Totales"/>
                            <field name="total_remittance" widget="monetary" string="Montant Réel Remis"/>
                            <field name="difference" widget="monetary" decoration-danger="difference &lt; 0" decoration-success="difference &gt;= 0" string="Écart de Caisse Final"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ventes Pompes et Boutique">
                            <group string="Ventes de Carburant (Pompes)">
                                <field name="pump_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="pompiste_id"/>
                                        <field name="pump_name"/>
                                        <field name="product_id"/>
                                        <field name="meter_opening" string="Index Ouverture"/>
                                        <field name="meter_closing" string="Index Fermeture"/>
                                        <field name="qty_sold" string="Quantité de Gallons" readonly="1"/>
                                        <field name="price_unit" string="Prix Unitaire du Gallon"/>
                                        <field name="amount_sold" sum="Total Ventes Pompes" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Ventes Boutique et Divers">
                                <field name="other_sale_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="qty" string="Quantité Vendue"/>
                                        <field name="amount" sum="Total Ventes Diverses"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Billets et Cash">
                            <group>
                                <group string="Décompte des Billets en Gourdes">
                                    <field name="bill_1000"/>
                                    <field name="bill_500"/>
                                    <field name="bill_250"/>
                                    <field name="bill_100"/>
                                    <field name="bill_50"/>
                                    <field name="bill_25"/>
                                    <field name="bill_10"/>
                                    <field name="coin_amount" string="Montant des Monnaies"/>
                                    <field name="total_cash_htg" string="TOTAL CASH EN GOURDES" class="oe_read_only"/>
                                </group>
                                <group string="Dollars et Terminaux de Paiement">
                                    <field name="cash_usd" string="Montant Dollars USD Cash"/>
                                    <field name="tpe_unibk" string="Terminal UNIBK"/>
                                    <field name="tpe_sgbk" string="Terminal SGBK"/>
                                    <field name="tpe_bandari" string="Terminal Bandari"/>
                                    <field name="subsidy_amount" string="Montant de la Subvention"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- L'ONGLET DES BONS, CRÉDITS ET CHÈQUES -->
                        <page string="Bons, Crédits et Chèques">
                            <group string="Bons de Carburant">
                                <field name="coupon_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="qty" string="Quantité de Bons"/>
                                        <field name="unit_value" string="Valeur Unitaire"/>
                                        <field name="amount" sum="Total des Bons"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Ventes à Crédit">
                                <field name="credit_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="customer_name" string="Nom du Client"/>
                                        <field name="reference" string="Numéro de la Fiche"/>
                                        <field name="amount" sum="Total des Crédits"/>
                                    </list>
                                </field>
                            </group>
                            
                            <!-- VOICI LA SECTION DES CHÈQUES -->
                            <group string="Chèques et Transferts Bancaires">
                                <field name="check_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="bank" string="Banque Émettrice"/>
                                        <field name="amount" sum="Total des Chèques"/>
                                    </list>
                                </field>
                            </group>
                            
                        </page>
                        
                        <page string="Cuves et Décaissements">
                            <group string="Inventaire des Cuves">
                                <field name="tank_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="tank_name" string="Nom de la Cuve"/>
                                        <field name="product_id" string="Produit Carburant"/>
                                        <field name="opening_qty" string="Quantité à l'Ouverture"/>
                                        <field name="closing_qty" string="Quantité à la Fermeture"/>
                                        <field name="net_qty" string="Quantité en Stock"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Sorties de Caisse (Décaissements)">
                                <field name="disbursement_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="beneficiary" string="Raison ou Bénéficiaire"/>
                                        <field name="amount" sum="Total des Dépenses"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action et Menus -->
    <record id="action_station_gauging" model="ir.actions.act_window">
        <field name="name">Fiches de Jaugeage</field>
        <field name="res_model">gauging.gauging</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_station_management" name="Gestion Station" sequence="1"/>
    <menuitem id="menu_station_gauging" name="Jaugeages" parent="menu_station_management" sequence="10" action="action_station_gauging"/>
</odoo>