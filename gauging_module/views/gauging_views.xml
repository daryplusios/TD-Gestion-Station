<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gauging_form" model="ir.ui.view">
        <field name="name">gauging.gauging.form</field>
        <field name="model">gauging.gauging</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Valider le Rapport" type="object" class="oe_highlight" invisible="state == 'validated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence du Rapport"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Configuration du Shift">
                            <field name="date" readonly="state == 'validated'"/>
                            <field name="shift" widget="radio" options="{'horizontal': true}" readonly="state == 'validated'"/>
                            <field name="supervisor_id" readonly="1"/>
                            <field name="currency_rate" string="Taux USD/HTG" readonly="state == 'validated'"/>
                        </group>
                        <group string="Résumé Financier" class="oe_subtotal_footer">
                            <field name="total_sales_expected" widget="monetary" string="Ventes Théoriques"/>
                            <field name="total_remittance" widget="monetary" string="Montant Réel Remis"/>
                            <field name="difference" widget="monetary" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0" string="Écart (Short/Over)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ventes Pompes">
                            <field name="pump_line_ids" readonly="state == 'validated'">
                                <list editable="bottom">
                                    <field name="pompiste_id"/>
                                    <field name="pump_name"/>
                                    <field name="product_id"/>
                                    <field name="meter_opening" string="Ouverture"/>
                                    <field name="meter_closing" string="Fermeture"/>
                                    <field name="calibration_qty" string="Calibrage"/>
                                    <field name="qty_sold" string="Gallons"/>
                                    <field name="price_unit" string="Prix Gal"/>
                                    <field name="amount_sold" sum="Total Ventes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Décompte Cash HTG/USD">
                            <group>
                                <group string="Détail Billets Gourdes">
                                    <field name="bill_1000"/>
                                    <field name="bill_500"/>
                                    <field name="bill_250"/>
                                    <field name="bill_100"/>
                                    <field name="bill_50"/>
                                    <field name="bill_25"/>
                                    <field name="bill_10"/>
                                    <field name="coin_amount" string="Pièces / Monnaies"/>
                                    <field name="total_cash_htg" string="TOTAL CASH HTG" class="oe_read_only"/>
                                </group>
                                <group string="USD &amp; TPE">
                                    <field name="cash_usd" string="Cash USD"/>
                                    <field name="tpe_unibk" string="UNIBK"/>
                                    <field name="tpe_sgbk" string="SGBK"/>
                                    <field name="tpe_bandari" string="Bandari"/>
                                    <field name="subsidy_amount" string="Subvention État"/>
                                </group>
                            </group>
                        </page>
                        <page string="Bons, Crédits &amp; Chèques">
                            <group string="Bons de Carburant (National/Total)">
                                <field name="coupon_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="name" string="Type de Bon"/>
                                        <field name="qty" string="Qté"/>
                                        <field name="unit_value" string="Valeur"/>
                                        <field name="amount" sum="Total Bons"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Ventes à Crédit">
                                <field name="credit_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="customer_name" string="Client"/>
                                        <field name="invoice_ref" string="Fiche #"/>
                                        <field name="product_id" string="Produit"/>
                                        <field name="qty" string="Qté Gal"/>
                                        <field name="amount" sum="Total Crédit"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Stocks &amp; Décaissements">
                            <group string="Inventaire des Cuves">
                                <field name="tank_line_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="tank_name" string="Nom Cuve"/>
                                        <field name="product_id" string="Produit"/>
                                        <field name="opening_qty" string="Ouv."/>
                                        <field name="closing_qty" string="Ferm."/>
                                        <field name="net_qty" string="Stock Final"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Sorties de Caisse (Décaissements)">
                                <field name="disbursement_ids" nolabel="1" readonly="state == 'validated'">
                                    <list editable="bottom">
                                        <field name="beneficiary" string="Raison / À qui"/>
                                        <field name="authorized_by" string="Autorisé par"/>
                                        <field name="amount" sum="Total Dépenses"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gauging_all" model="ir.actions.act_window">
        <field name="name">Suivi Jaugeages</field>
        <field name="res_model">gauging.gauging</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gauging_root" name="Gestion Station" sequence="10"/>
    <menuitem id="menu_gauging_main" name="Fiches de Jaugeage" parent="menu_gauging_root" action="action_gauging_all"/>
</odoo>