<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Déclaration de l'action d'impression -->
    <record id="action_report_gauging" model="ir.actions.report">
        <field name="name">Rapport de Gauging</field>
        <field name="model">gauging.gauging</field>
        <field name="report_type">qweb-pdf</field>
        <!-- Utilisation du nom technique correct du dossier : gauging_module -->
        <field name="report_name">gauging_module.report_gauging_template</field>
        <field name="report_file">gauging_module.report_gauging_template</field>
        <field name="print_report_name">'Gauging - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_gauging_gauging"/>
        <field name="binding_type">report</field>
    </record>
</odoo>