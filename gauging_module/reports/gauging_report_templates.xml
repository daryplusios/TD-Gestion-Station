<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template 1 : Rapport de Décompte Financier -->
    <template id="report_decompte_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">RAPPORT DE DÉCOMPTE : <span t-field="doc.name"/></h2>
                        <div class="row mt32 mb32">
                            <div class="col-6"><strong>Superviseur :</strong> <span t-field="doc.supervisor_id.name"/></div>
                            <div class="col-6"><strong>Date :</strong> <span t-field="doc.date"/> | <strong>Rotation :</strong> <span t-field="doc.shift"/></div>
                        </div>

                        <h3>Ventes Pompes</h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Pompiste</th><th>Pompe</th><th>Qté (Gal)</th><th>Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.pump_line_ids" t-as="p">
                                    <tr>
                                        <td><span t-field="p.pompiste_id.name"/></td>
                                        <td><span t-field="p.pump_name"/></td>
                                        <td class="text-end"><span t-field="p.qty_sold"/></td>
                                        <td class="text-end"><span t-field="p.amount_sold"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h3 class="mt32">Récapitulatif Financier</h3>
                        <table class="table table-sm table-borderless" style="width: 50%;">
                            <tr><td>Ventes Théoriques :</td><td class="text-end"><span t-field="doc.total_sales_expected"/></td></tr>
                            <tr><td>Montant Réel Remis :</td><td class="text-end"><span t-field="doc.total_remittance"/></td></tr>
                            <tr class="border-top"><td><strong>Écart (Short/Over) :</strong></td><td class="text-end"><strong><span t-field="doc.difference"/></strong></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Template 2 : Rapport d'Inventaire -->
    <template id="report_inventaire_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">INVENTAIRE DES CUVES : <span t-field="doc.name"/></h2>
                        <table class="table table-bordered mt32">
                            <thead>
                                <tr><th>Cuve</th><th>Produit</th><th>Ouverture</th><th>Fermeture</th><th>Stock Final</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.tank_line_ids" t-as="t">
                                    <tr>
                                        <td><span t-field="t.tank_name"/></td>
                                        <td><span t-field="t.product_id.name"/></td>
                                        <td class="text-end"><span t-field="t.opening_qty"/></td>
                                        <td class="text-end"><span t-field="t.closing_qty"/></td>
                                        <td class="text-end"><span t-field="t.net_qty"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>