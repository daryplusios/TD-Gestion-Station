<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF : FICHE INDIVIDUELLE (Un seul shift) -->
    <template id="report_decompte_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">RAPPORT DE DÉCOMPTE : <span t-field="doc.name"/></h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6"><strong>Superviseur :</strong> <span t-field="doc.supervisor_id.name"/></div>
                            <div class="col-6 text-end"><strong>Date :</strong> <span t-field="doc.date"/> | <span t-field="doc.shift"/></div>
                        </div>

                        <h4>1. Ventes Pompes</h4>
                        <table class="table table-sm table-bordered">
                            <tr class="table-active"><th>Pompe</th><th>Produit</th><th class="text-end">Gallons</th><th class="text-end">Prix</th><th class="text-end">Montant</th></tr>
                            <t t-foreach="doc.pump_line_ids" t-as="p">
                                <tr>
                                    <td><span t-field="p.pump_name"/></td><td><span t-field="p.product_id.name"/></td>
                                    <td class="text-end"><span t-field="p.qty_sold"/></td><td class="text-end"><span t-field="p.price_unit"/></td><td class="text-end"><span t-field="p.amount_sold"/></td>
                                </tr>
                            </t>
                        </table>

                        <h4 class="mt-4">2. Bilan Financier</h4>
                        <table class="table table-sm">
                            <tr><td><strong>Total Ventes Théoriques :</strong></td><td class="text-end"><span t-field="doc.total_sales_expected"/></td></tr>
                            <tr><td><strong>Total Montant Réel Remis :</strong></td><td class="text-end"><span t-field="doc.total_remittance"/></td></tr>
                            <tr class="table-active"><td><strong>ÉCART DE CAISSE FINAL :</strong></td><td class="text-end"><strong><span t-field="doc.difference"/></strong></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_inventaire_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">INVENTAIRE DES STOCKS : <span t-field="doc.name"/></h2>
                        <table class="table table-bordered mt-4">
                            <tr class="table-active"><th>Nom de la Cuve</th><th class="text-end">Ouverture</th><th class="text-end">Fermeture</th><th class="text-end">Quantité Vendue</th></tr>
                            <t t-foreach="doc.tank_line_ids" t-as="t">
                                <tr>
                                    <td><span t-field="t.tank_name"/></td><td class="text-end"><span t-field="t.opening_qty"/></td>
                                    <td class="text-end"><span t-field="t.closing_qty"/></td><td class="text-end"><span t-field="t.qty_sold"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- PDF : GRAND TOTAL CONSOLIDÉ (La journée entière) -->
    <template id="report_daily_decompte_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">GRAND TOTAL DÉCOMPTE (AM + PM)</h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6"><strong>Date :</strong> <span t-field="doc.date"/></div>
                            <div class="col-6"><strong>Superviseur :</strong> <span t-field="doc.supervisor_id.name"/></div>
                        </div>

                        <h4>1. Synthèse Financière de la Journée</h4>
                        <table class="table table-bordered">
                            <tr><td><strong>Total Cash :</strong></td><td class="text-end"><span t-field="doc.total_cash"/></td></tr>
                            <tr><td><strong>Total Cartes (TPE) :</strong></td><td class="text-end"><span t-field="doc.total_carte"/></td></tr>
                            <tr><td><strong>Total Coupons (Bons) :</strong></td><td class="text-end"><span t-field="doc.total_coupons"/></td></tr>
                            <tr><td><strong>Total Chèques :</strong></td><td class="text-end"><span t-field="doc.total_cheque"/></td></tr>
                            <tr><td><strong>Total Crédits :</strong></td><td class="text-end"><span t-field="doc.total_credit"/></td></tr>
                        </table>

                        <h4 class="mt-4">2. Ventes de Carburant (Gallons) par Citerne</h4>
                        <table class="table table-sm table-bordered">
                            <tr class="table-active"><th>Nom de la Cuve</th><th class="text-end">Quantité Vendue (Journée)</th></tr>
                            <tr><td>Super Tank 1 (Gazoline)</td><td class="text-end"><span t-field="doc.tank_1_sold"/></td></tr>
                            <tr><td>Super Tank 2 (Gazoline)</td><td class="text-end"><span t-field="doc.tank_2_sold"/></td></tr>
                            <tr><td>Diesel Tank 3</td><td class="text-end"><span t-field="doc.tank_3_sold"/></td></tr>
                            <tr><td>Diesel Tank 4</td><td class="text-end"><span t-field="doc.tank_4_sold"/></td></tr>
                            <tr><td>Super Tank 5 (Gazoline)</td><td class="text-end"><span t-field="doc.tank_5_sold"/></td></tr>
                            <tr><td>Super Tank 6 (Gazoline)</td><td class="text-end"><span t-field="doc.tank_6_sold"/></td></tr>
                            <tr><td>Propane Tank 1</td><td class="text-end"><span t-field="doc.propane_1_sold"/></td></tr>
                            <tr><td>Propane Tank 2</td><td class="text-end"><span t-field="doc.propane_2_sold"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_daily_inventaire_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">RAPPORT D'INVENTAIRE RÉSUMÉ (AM + PM)</h2>
                        <div class="row mt-4 mb-4"><div class="col-12 text-center"><strong>Date :</strong> <span t-field="doc.date"/></div></div>
                        <table class="table table-bordered">
                            <thead>
                                <tr class="table-active">
                                    <th>Nom de la Cuve</th>
                                    <th class="text-end">Début Shift AM</th>
                                    <th class="text-end">Fin Shift PM</th>
                                    <th class="text-end">Quantité Vendue (Différence)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.tank_name"/></td>
                                        <td class="text-end"><span t-field="line.open_am"/></td>
                                        <td class="text-end"><span t-field="line.close_pm"/></td>
                                        <td class="text-end"><strong><span t-field="line.variance"/></strong></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>